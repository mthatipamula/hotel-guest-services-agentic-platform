# Settings for the GCP deployment scripts. Override any of them with environment variables.
PROJECT_ID=${PROJECT_ID:-hotel-guest-ops-agentic}
REGION=${REGION:-us-central1}
# Partner agents run in a different region to model an external partner network.
PARTNER_REGION=${PARTNER_REGION:-us-east1}
# Vertex AI region for Gemini and embeddings (all services).
VERTEX_LOCATION=${VERTEX_LOCATION:-us-central1}
REPO=${REPO:-guestops}
TAG=${TAG:-v2}
SQL_INSTANCE=${SQL_INSTANCE:-guestops-pg}
# db-f1-micro is the cheapest shared-core tier: fine for a demo, not for production.
SQL_TIER=${SQL_TIER:-db-f1-micro}
DB_USER=${DB_USER:-guestops}
DB_PASSWORD_SECRET=${DB_PASSWORD_SECRET:-guestops-db-password}
# true = anyone with the URL can use the console (and spend Vertex AI tokens). Default: IAM only.
PUBLIC_UI=${PUBLIC_UI:-true}

SERVICES="agent-registry hotel-mcp-server revenue-agents partner-agents guest-ops-orchestrator"
